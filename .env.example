APP_NAME=CryptoPredictor
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
# Frontend addresses allowed to call the API (Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=

MARKET_DATA_PROVIDER=binance
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
# Alternative public mirror: https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com

DATA_DIR=data
MODEL_ARTIFACTS_DIR=artifacts
